# cmd.exe misreads labels (call :label) in batch files with LF line endings.
*.cmd text eol=crlf
*.bat text eol=crlf
# Specialization hints (tools/local/static-precompile/hints-*.hints): zstd-compressed, never converted.
*.hints binary
# Shell scripts run in bash on Linux, WSL and Git Bash: LF in every checkout (a CR ends each command line badly).
*.sh text eol=lf
